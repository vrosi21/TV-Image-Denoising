<?xml version='1.0'?>
<SetupCollector xmlns:win="windows" xmlns:mac="macOS" xmlns:lin="linux" executableName="TVDenoising">
	<Folders dev="~/Desktop/TVDenoising" executable="$RAMDisk/Out/TVDenoising/Release" out="$RAMDisk/Setup/TVDenoising"/>
	<Packages debug="false">
		<Package name="natGUIALL"/>
		<Package name="Matrix"/>
		<Package name="GTK4" exclude="macOS,linux"/>
	</Packages>
	<ResData>
		<Res type="folder" dev="$MyBin/GTK/release/share/glib-2.0/schemas" dep="schemas" exclude="macOS,linux"/>
	</ResData>
	<MutableResource/>
	<Setup licenseFileName="~/Desktop/TVDenoising/Implementation/LICENSE"
			categories="Education;Science;Graphics"
			win:programGroup="ETF"
			win:width="440"
			win:headerBackColor="#2E4A7A"
			win:headerTxtColor="#FFFFFF"
			win:licenseTxtColor="#AABBCC"
			win:useMakeCabinet="true"
			win:minBuildNumber="17763"
			lin:depends="$DepGTKv4"/>
</SetupCollector>
